# ==============================================================================
# RABTA Blood Donation & Blood Bank Management Platform - Environment Variables
# Official Brand: RABTA
# Tagline: Connecting Lives. One Donation at a Time.
# ==============================================================================

# Server Network Configuration
RABTA_PORT=8080
RABTA_HOST=0.0.0.0
RABTA_ENVIRONMENT=production

# Security & Session Secrets
RABTA_SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_SECRET

# Database Configuration (Defaults to embedded SQLite with WAL mode)
# For external PostgreSQL migration, set DATABASE_URL
DATABASE_URL=sqlite:///rabta.db

# Google Maps API Integration
# When provided, enhances hospital address search and directions.
# (An interactive visualizer map with Karachi district bounds is built-in as zero-config fallback)
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# Emergency SMS Gateway Configuration (e.g. Twilio / Telenor / Jazz)
RABTA_SMS_PROVIDER=mock_and_audit
RABTA_SMS_KEY=YOUR_SMS_API_KEY
RABTA_SMS_SENDER=RABTA_EMERGENCY

# Emergency Email Gateway Configuration (e.g. SendGrid / SMTP)
RABTA_SMTP_HOST=smtp.sendgrid.net
RABTA_SMTP_PORT=587
RABTA_SMTP_USER=apikey
RABTA_SMTP_PASS=YOUR_SENDGRID_KEY
RABTA_EMAIL_FROM=emergency@rabta.pk
